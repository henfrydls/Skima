{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Capability for the main Skima window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/henfrydls/Skima" },
        { "url": "https://github.com/henfrydls/Skima/*" },
        { "url": "https://www.gnu.org/licenses/*" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/skima-server",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/skima-server",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
