{
  "name": "skima-server",
  "version": "1.5.0-rc.4",
  "private": true,
  "type": "module",
  "bin": "src/index.js",
  "scripts": {
    "dev": "node --watch-path=src src/index.js",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run --coverage",
    "build:sidecars": "node scripts/build-sidecars.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/client": "^6.0.0",
    "@prisma/driver-adapter-utils": "6.19.3",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
