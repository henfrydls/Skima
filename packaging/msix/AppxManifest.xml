<?xml version="1.0" encoding="utf-8"?>

<!--
  Microsoft Store package manifest. Tauri has no MSIX target, so msix.yml assembles the
  package from the Windows build and this file.

  The identity below is a valid placeholder, not ours: Partner Center assigns Name,
  Publisher and PublisherDisplayName when the app name is reserved, and they must match
  character for character on upload. msix.yml substitutes them from repository variables
  for a Store build; with the placeholders the package packs but cannot be uploaded.

  Version is written by msix.yml from package.json with a fourth part of 0 (reserved for
  the Store).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Placeholder.Skima"
    Publisher="CN=00000000-0000-0000-0000-000000000000"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Skima</DisplayName>
    <PublisherDisplayName>Placeholder Publisher</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 1809 is the oldest Windows the Store serves; 26100 is the CI runner's build. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- A packaged Win32 app: full trust entry point, hence runFullTrust below. -->
    <Application Id="Skima" Executable="Skima.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Skima"
        Description="People Development Platform"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- No Square310x310: makeappx requires a Wide310x150 logo alongside it, and we have none. -->
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
